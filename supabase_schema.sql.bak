-- Log permintaan reset WhatsApp untuk rate-limit.
create table if not exists public.recovery_requests (
  id uuid primary key default gen_random_uuid(),
  phone_normalized text not null,
  requested_at timestamptz not null default now()
);
create index if not exists recovery_requests_phone_time_idx on public.recovery_requests(phone_normalized, requested_at desc);
alter table public.recovery_requests enable row level security;
-- Tidak ada policy publik: tabel ini hanya dipakai oleh Edge Function dengan service_role.
